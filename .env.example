# Kopieer dit bestand naar .env en vul de waarden in. .env komt NOOIT in git
# of in de chat. Op DigitalOcean zet je dezelfde variabelen in het dashboard
# (sleutels als "Encrypted").

# --- taxiID (productie, alleen lezen) ---------------------------------------
# Dezelfde sleutel als in de .env van het boekingsformulier.
TAXIID_PROD_API_KEY=
# TAXIID_PROD_BASE_URL=https://api.dispatchapi.io/api
TAXIID_COMPANY_ID=5e76134226a257e34bd9bb17
# Hoe lang ritten uit taxiID bewaard worden voor ze opnieuw opgehaald worden.
# TAXIID_CACHE_SECONDS=300

# --- Garagescherm -------------------------------------------------------------
PORT=3000
# Geheim stukje in de link van het scherm: http://.../?t=<GARAGE_TOKEN>
# Leeg = iedereen met de link ziet het scherm (alleen kentekens, tijden, plaatsen).
GARAGE_TOKEN=
# Vanaf dit uur toont het scherm de ritten van morgen (daarvoor: vandaag).
# GARAGE_WISSELUUR=12

# --- Rooster (Google Agenda) ----------------------------------------------
# Geheim iCal-adres van de agenda met de diensten (Agenda-instellingen ->
# "Geheim adres in iCal-indeling"). Wie bij welke chauffeur hoort: config/rooster.json.
ROOSTER_ICS_URL=

# --- Telegram-vluchtbot -------------------------------------------------------
# Van @BotFather. Zonder token draait alleen het garagescherm.
TELEGRAM_BOT_TOKEN=
# Code die een chauffeur één keer naar de bot stuurt om toegang te krijgen.
BOT_TOEGANGSCODE=
# Chat-id's (komma's) die meldingen over nieuwe chauffeurs krijgen en
# /gebruik, /chauffeurs en /verwijder mogen. Je eigen id: stuur /id naar de bot.
BOT_BEHEER_CHAT_IDS=

# --- Vluchtgegevens: AeroDataBox ---------------------------------------------
AERODATABOX_API_KEY=
# rapidapi (standaard) of apimarket
# AERODATABOX_PROVIDER=rapidapi
# Kosten per aanroep in units en het maximum per dag (bewaking).
AERODATABOX_UNITS_PER_CALL=2
FLIGHT_DAILY_UNITS=300
# Luchthavens waar onze ritten beginnen/eindigen (IATA). Bepaalt welk deel
# van een vlucht met tussenstop gevolgd wordt.
# THUIS_LUCHTHAVENS=EIN,AMS,RTM,BRU,CRL,DUS,NRN,CGN,MST,LGG

# --- Opslag op DigitalOcean (App Platform heeft geen blijvende schijf) -------
# Zelfde Space als het boekingsformulier mag; dit bestand komt onder een eigen sleutel.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=ams3
# SPACES_STATE_KEY=chauffeursdiensten/state.json
